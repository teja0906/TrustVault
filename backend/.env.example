# TrustVault Backend Configuration

# Server
PORT=4000
NODE_ENV=development

# Database Connection (Provide either DATABASE_URL or individual host/port/db credentials)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trustvault
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=trustvault
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Authentication
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_chars_long

# CORS Allowed Frontend Origin(s)
FRONTEND_URL=http://localhost:5173

# Document Storage Configuration
# Local storage fallback directory
UPLOAD_DIR=./uploads

# Supabase Storage (Required for Render production deployment)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=trustvault-documents

# Initial Administrator Provisioning (Optional)
ADMIN_EMAIL=admin@trustvault.local
ADMIN_INITIAL_PASSWORD=
